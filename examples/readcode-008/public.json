  "tasks": [
    {
      "id": "T1",
      "type": "incident",
      "text": "Dragon Noodle House (Toronto), Tuesday: \"Since Sunday we've been getting orders around 10:00, but we open at 11:00, and we have to cancel them. Customers also tell us the app shows us closed from about 21:00, though we close at 22:00. Nothing changed on our side.\" Find the cause.",
      "parts": [
        {
          "id": "where",
          "prompt": "Where is the cause? Select the lines in the code (any file).",
          "select": "lines"
        },
        {
          "id": "why",
          "prompt": "Why does that produce what they see?",
          "options": [
            {
              "id": "a",
              "text": "Opening hours that run past midnight are handled wrongly, which shifts the window."
            },
            {
              "id": "b",
              "text": "is_open uses < at closing time, so the last minutes count as closed."
            },
            {
              "id": "c",
              "text": "Local time is computed from the UTC offset saved when the restaurant signed up in summer. Since the clocks went back, Toronto is an hour further behind UTC, so the app thinks it is an hour later than it is."
            },
            {
              "id": "d",
              "text": "The server's clock runs in UTC and the hours are compared as UTC."
            }
          ]
        },
        {
          "id": "fix",
          "prompt": "Which change fixes it?",
          "options": [
            {
              "id": "a",
              "text": "Convert with the restaurant's time zone",
              "diff": "--- a/market/catalog.py\n+++ b/market/catalog.py\n@@\n+from zoneinfo import ZoneInfo\n@@ local_time\n-    return now_utc + timedelta(minutes=restaurant[\"utc_offset_minutes\"])\n+    return now_utc.astimezone(ZoneInfo(restaurant[\"timezone\"]))\n"
            },
            {
              "id": "b",
              "text": "Update every restaurant's saved offset",
              "diff": "--- /dev/null\n+++ b/migrations/0007_fix_offsets.sql\n+UPDATE restaurants SET utc_offset_minutes = utc_offset_minutes - 60;\n"
            },
            {
              "id": "c",
              "text": "Subtract an hour in winter",
              "diff": "--- a/market/catalog.py\n+++ b/market/catalog.py\n@@ local_time\n-    return now_utc + timedelta(minutes=restaurant[\"utc_offset_minutes\"])\n+    winter = now_utc.month in (11, 12, 1, 2, 3)\n+    return now_utc + timedelta(minutes=restaurant[\"utc_offset_minutes\"] - (60 if winter else 0))\n"
            },
            {
              "id": "d",
              "text": "Store opening hours in UTC",
              "diff": "--- a/market/catalog.py\n+++ b/market/catalog.py\n@@ is_open\n-    t = local_time(restaurant, now_s).time()\n+    t = datetime.fromtimestamp(now_s, timezone.utc).time()   # opens_at/closes_at migrated to UTC\n"
            }
          ]
        }
      ]
    }
  ]
