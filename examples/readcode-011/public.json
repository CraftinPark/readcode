  "tasks": [
    {
      "id": "T1",
      "type": "incident",
      "text": "Dragon Noodle House: \"Yesterday at 18:40 a customer's order sat at 'payment processing', so they cancelled it and got a refund. About twenty minutes later our tablet showed it as a new paid order, so we cooked it. The customer also got a 'payment confirmed' email after their refund.\" Find the cause.",
      "parts": [
        {
          "id": "where",
          "prompt": "Where is the cause? Select the lines in the code (any file).",
          "select": "lines"
        },
        {
          "id": "why",
          "prompt": "Why does that produce what they see?",
          "options": [
            {
              "id": "a",
              "text": "The provider sent payment.succeeded twice and the second copy was processed again."
            },
            {
              "id": "b",
              "text": "The provider delivered payment.succeeded after refund.succeeded. The status check only skips an event that repeats the current status, so 'paid' overwrote 'refunded' and the new-order messages went out."
            },
            {
              "id": "c",
              "text": "cancel() asks for the refund before marking the order cancelled, so for a moment the order looked live."
            },
            {
              "id": "d",
              "text": "The refund was smaller than the order total, so the order stayed payable."
            }
          ]
        },
        {
          "id": "fix",
          "prompt": "Which change fixes it?",
          "options": [
            {
              "id": "a",
              "text": "Don't notify the restaurant about cancelled orders",
              "diff": "--- a/market/payments.py\n+++ b/market/payments.py\n@@ handle_event\n-            if new == \"paid\":\n+            if new == \"paid\" and order[\"status\"] != \"cancelled\":\n"
            },
            {
              "id": "b",
              "text": "Deduplicate events by payment id",
              "diff": "--- a/market/payments.py\n+++ b/market/payments.py\n@@ handle_event\n-        if conn.execute(\"SELECT 1 FROM provider_events WHERE id = ?\", (event[\"id\"],)).fetchone():\n+        if conn.execute(\"SELECT 1 FROM provider_events WHERE id = ?\", (event[\"data\"][\"payment_id\"],)).fetchone():\n"
            },
            {
              "id": "c",
              "text": "Sort events by their created time before processing",
              "diff": "--- a/market/app.py\n+++ b/market/app.py\n@@ provider_webhook\n-    def provider_webhook(event: dict):\n+    def provider_webhook(event: dict):\n+        time.sleep(5)  # let earlier events arrive first\n"
            },
            {
              "id": "d",
              "text": "Only let the payment status move forward",
              "diff": "--- a/market/payments.py\n+++ b/market/payments.py\n@@\n+RANK = {\"pending\": 0, \"failed\": 1, \"paid\": 1, \"refunded\": 2}\n@@ _set_payment_status\n-    if new == current:\n+    if RANK[new] <= RANK[current]:\n         return False\n"
            }
          ]
        }
      ]
    }
  ]
