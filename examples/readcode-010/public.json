  "tasks": [
    {
      "id": "T1",
      "type": "incident",
      "text": "Dispatch lead: \"Every evening, from around 19:00, dispatching starts failing with 'No courier is available right now', although the live map shows couriers on shift and idle. Restarting the service doesn't help. Two couriers told us their app says they are at their job limit while they have no jobs.\" Find the cause.",
      "parts": [
        {
          "id": "where",
          "prompt": "Where is the cause? Select the lines in the code (any file).",
          "select": "lines"
        },
        {
          "id": "why",
          "prompt": "Why does that produce what they see?",
          "options": [
            {
              "id": "a",
              "text": "MAX_ACTIVE_JOBS is 2, which is too low for evening volume."
            },
            {
              "id": "b",
              "text": "assign() always picks the courier with the lowest id, so one courier gets every order."
            },
            {
              "id": "c",
              "text": "release() refuses to go below zero, so the counter drifts upward."
            },
            {
              "id": "d",
              "text": "Cancelling an order that has a courier assigned but not yet picked up never gives the courier their slot back, so each such cancellation leaves a phantom job on the courier."
            }
          ]
        },
        {
          "id": "fix",
          "prompt": "Which change fixes it?",
          "options": [
            {
              "id": "a",
              "text": "Allow 4 jobs per courier",
              "diff": "--- a/market/dispatch.py\n+++ b/market/dispatch.py\n-MAX_ACTIVE_JOBS = 2\n+MAX_ACTIVE_JOBS = 4\n"
            },
            {
              "id": "b",
              "text": "Free the courier for assigned and picked-up orders",
              "diff": "--- a/market/orders.py\n+++ b/market/orders.py\n@@ cancel\n-        if order[\"status\"] == \"picked_up\":\n+        if order[\"status\"] in (\"assigned\", \"picked_up\"):\n             dispatch.release(conn, order[\"courier_id\"])\n"
            },
            {
              "id": "c",
              "text": "Reset every courier's counter nightly",
              "diff": "--- a/ops/schedule.yaml\n+++ b/ops/schedule.yaml\n+  reset_couriers: \"0 4 * * *\"   # UPDATE couriers SET active_jobs = 0\n"
            },
            {
              "id": "d",
              "text": "Clear the courier on cancelled orders",
              "diff": "--- a/market/orders.py\n+++ b/market/orders.py\n@@ cancel\n-        conn.execute(\"UPDATE orders SET status = 'cancelled', updated_ms = ? WHERE id = ?\", (now_ms, order_id))\n+        conn.execute(\"UPDATE orders SET status = 'cancelled', courier_id = NULL, updated_ms = ? WHERE id = ?\", (now_ms, order_id))\n"
            }
          ]
        }
      ]
    }
  ]
