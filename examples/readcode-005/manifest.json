      "file": "saleor/graphql/checkout/resolvers.py",
      "line": 17,
      "change": {
        "old": "def resolve_checkout(info, token):\n    checkout = models.Checkout.objects.filter(token=token).first()\n\n    if checkout is None:\n        return None\n\n    # resolve checkout for anonymous customer\n    if not checkout.user:\n        return checkout\n\n    # resolve checkout for logged-in customer\n    if checkout.user == info.context.user:\n        return checkout\n\n    # resolve checkout for staff user\n    requester = get_user_or_service_account_from_context(info.context)\n    if requester.has_perm(CheckoutPermissions.MANAGE_CHECKOUTS):\n        return checkout\n\n    return None\n",
        "new": "def resolve_checkout(token):\n    return models.Checkout.objects.filter(token=token).first()\n"
