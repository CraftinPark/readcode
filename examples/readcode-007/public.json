  "tasks": [
    {
      "id": "T1",
      "type": "incident",
      "text": "Finance team: \"Our nightly reconciliation flags 2-3% of orders as off by one to three cents: what the customer was charged doesn't equal what we pay the restaurant on plus delivery fee and tax. Every flagged order used a promo code, but most promo orders are fine. Example from yesterday: Bao, Spring rolls and Hot and sour soup with SAVE10 is off by +1 cent.\" Find the cause.",
      "parts": [
        {
          "id": "where",
          "prompt": "Where is the cause? Select the lines in the code (any file).",
          "select": "lines"
        },
        {
          "id": "why",
          "prompt": "Why does that produce what they see?",
          "options": [
            {
              "id": "a",
              "text": "percent() rounds half up, so the order discount itself comes out a cent too high."
            },
            {
              "id": "b",
              "text": "Each line's share of the discount is rounded on its own, so the shares can add up to more or less than the order discount and the lines' net no longer matches the food total."
            },
            {
              "id": "c",
              "text": "Tax is computed on the food total, but restaurants are paid on line amounts before tax."
            },
            {
              "id": "d",
              "text": "The promo also discounts the delivery fee on the order, but not on the lines."
            }
          ]
        },
        {
          "id": "fix",
          "prompt": "Which change fixes it?",
          "options": [
            {
              "id": "a",
              "text": "Round the order discount down instead of half up",
              "diff": "--- a/market/pricing.py\n+++ b/market/pricing.py\n@@ quote\n-        discount = percent(subtotal, promo[\"percent_off\"])\n+        discount = int(subtotal * promo[\"percent_off\"] / 100)\n"
            },
            {
              "id": "b",
              "text": "Share the discount so the parts add up exactly",
              "diff": "--- a/market/pricing.py\n+++ b/market/pricing.py\n@@\n-from .money import percent\n+from .money import allocate, percent\n@@ quote\n-    shares = [percent(l[\"amount\"], discount * 100 / subtotal) for l in lines]\n+    shares = allocate(discount, [l[\"amount\"] for l in lines])\n"
            },
            {
              "id": "c",
              "text": "Use the promo's own percentage for each line",
              "diff": "--- a/market/pricing.py\n+++ b/market/pricing.py\n@@ quote\n-    shares = [percent(l[\"amount\"], discount * 100 / subtotal) for l in lines]\n+    shares = [percent(l[\"amount\"], promo[\"percent_off\"]) if promo_code else 0 for l in lines]\n"
            },
            {
              "id": "d",
              "text": "Let reconciliation tolerate a few cents",
              "diff": "--- a/market/app.py\n+++ b/market/app.py\n@@ reconciliation\n-            if expected != o[\"total\"]:\n+            if abs(expected - o[\"total\"]) > 3:\n"
            }
          ]
        }
      ]
    }
  ]
