  "tasks": [
    {
      "id": "T1",
      "type": "incident",
      "text": "Finance team: \"Audit of October: for 11 missing-item refunds the restaurant was still paid in full for the item, so we covered the refund ourselves. The refunds were issued normally and later settled with the provider. Other refunds that month were deducted correctly. Payouts run every Wednesday morning; most of the 11 were issued Monday to Wednesday.\" Find the cause.",
      "parts": [
        {
          "id": "where",
          "prompt": "Where is the cause? Select the lines in the code (any file).",
          "select": "lines"
        },
        {
          "id": "why",
          "prompt": "Why does that produce what they see?",
          "options": [
            {
              "id": "a",
              "text": "Payouts deduct only refunds that have settled. A refund still pending when the payout runs is skipped, and the next payout only covers refunds created after its start, so it is never deducted."
            },
            {
              "id": "b",
              "text": "Refunds on orders that are not delivered are excluded, and these orders were refunded before delivery."
            },
            {
              "id": "c",
              "text": "Commission is taken from gross before refunds, so the restaurant keeps the commission on refunded items."
            },
            {
              "id": "d",
              "text": "The refund.succeeded event is processed twice and cancels the deduction."
            }
          ]
        },
        {
          "id": "fix",
          "prompt": "Which change fixes it?",
          "options": [
            {
              "id": "a",
              "text": "Run payouts on Friday instead of Wednesday",
              "diff": "--- a/ops/schedule.yaml\n+++ b/ops/schedule.yaml\n-  payouts: \"0 6 * * WED\"\n+  payouts: \"0 6 * * FRI\"\n"
            },
            {
              "id": "b",
              "text": "Match refunds to the period by the order's date",
              "diff": "--- a/market/payouts.py\n+++ b/market/payouts.py\n@@ preview\n-        \"AND r.created_ms > ? AND r.created_ms <= ?\",\n+        \"AND o.created_ms > ? AND o.created_ms <= ?\",\n"
            },
            {
              "id": "c",
              "text": "Deduct refunds that are pending or settled",
              "diff": "--- a/market/payouts.py\n+++ b/market/payouts.py\n@@ preview\n-        \"WHERE o.restaurant_id = ? AND o.status = 'delivered' AND r.status = 'succeeded' \"\n+        \"WHERE o.restaurant_id = ? AND o.status = 'delivered' AND r.status IN ('pending', 'succeeded') \"\n"
            },
            {
              "id": "d",
              "text": "Also deduct refunds on cancelled orders",
              "diff": "--- a/market/payouts.py\n+++ b/market/payouts.py\n@@ preview\n-        \"WHERE o.restaurant_id = ? AND o.status = 'delivered' AND r.status = 'succeeded' \"\n+        \"WHERE o.restaurant_id = ? AND o.status IN ('delivered', 'cancelled') AND r.status = 'succeeded' \"\n"
            }
          ]
        }
      ]
    }
  ]
