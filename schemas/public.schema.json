{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readcode.example/schemas/public.schema.json",
  "title": "ReadCode public exercise definition (safe to send to candidates)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "language", "difficulty", "track", "area", "rung", "topics", "estimated_minutes", "files", "license", "questions", "design_prompts"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^readcode-[0-9]{3,}$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "language": {"enum": ["c", "cpp", "python", "go", "rust", "java", "javascript", "typescript"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "track": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "taxonomy track id"},
    "area": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "taxonomy area id; must belong to the track"},
    "rung": {"type": "integer", "minimum": 1, "maximum": 5, "description": "difficulty ladder: 1 one function, 3 one file, 5 a small repo"},
    "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
               "description": "non-revealing taxonomy topics only; skills (bug classes) live in key.json"},
    "estimated_minutes": {"type": "integer", "minimum": 5, "maximum": 180},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "line_count"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
          "line_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["spdx", "attribution"],
      "properties": {
        "spdx": {"type": "string", "minLength": 1},
        "attribution": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"}
      }
    },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/prompt_c"}
    },
    "design_prompts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/prompt_d"}
    },
    "tasks": {
      "type": "array", "description": "Extra question types (incident ticket, PR review, trace). Not scored by the grader yet.",
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "prompt_c": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {"id": {"type": "string", "pattern": "^C[0-9]+$"}, "text": {"type": "string", "minLength": 10}}
    },
    "prompt_d": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {"id": {"type": "string", "pattern": "^D[0-9]+$"}, "text": {"type": "string", "minLength": 10}}
    },
    "task": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^T[0-9]+$"},
        "type": {"enum": ["incident", "review_pr", "trace"]},
        "text": {"type": "string", "minLength": 10},
        "diff": {"type": "string", "minLength": 10},
        "options": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "text"],
            "properties": {"id": {"type": "string", "pattern": "^[a-z]$"}, "text": {"type": "string", "minLength": 1}}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "review_pr"}}}, "then": {"required": ["diff"]}},
        {"if": {"properties": {"type": {"const": "trace"}}}, "then": {"required": ["options"]}}
      ]
    }
  }
}
